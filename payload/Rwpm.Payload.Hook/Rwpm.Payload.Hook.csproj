<Project Sdk="Microsoft.NET.Sdk">

  <!-- Waylith (RimWorld 1.7) OFFLINE redirect, loaded through DOTNET_STARTUP_HOOKS.
       net6.0 so it loads in any .NET >= 6 process that inherits the env, e.g.
       net8 helpers the game starts. No game references: everything is by reflection. -->
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>Rwpm.Payload.Hook</AssemblyName>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../Shared/ModsRedirect.cs" Link="Shared/ModsRedirect.cs" />
  </ItemGroup>

</Project>
