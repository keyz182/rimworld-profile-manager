<Project Sdk="Microsoft.NET.Sdk">

  <!-- T12 e2e stand-in for a foreign Doorstop target (e.g. pardeike's Doorstop.dll). -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>Doorstop</AssemblyName>
    <RootNamespace>Doorstop</RootNamespace>
    <LangVersion>9.0</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
